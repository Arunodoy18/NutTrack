# --- AI & Vision Services ---
# OpenAI is no longer used anywhere in this app (kept only as an SDK
# dependency, since Groq's client below reuses the OpenAI SDK class pointed
# at Groq's own endpoint). No OPENAI_API_KEY needed.

# Groq powers the text-only AI paths: text-based meal logging, the daily
# nutrition insight, and the AI chat advisor. OpenAI-compatible API.
GROQ_API_KEY=your_groq_api_key_here

# Gemini powers meal/fridge photo analysis (Groq has no vision models).
# Free tier: Google may review/train on submitted images - see privacy policy.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_string_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# --- Email Service (Resend) ---
RESEND_API_KEY=re_your_resend_api_key

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# --- Payments (RevenueCat, mobile app) ---
REVENUECAT_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# --- Rate limiting & AI response caching (Upstash Redis) ---
# Without these, checkScanRateLimit() falls back to "allow everything" -
# no crash, but scan-abuse protection on the AI-backed endpoints is off.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Mobile sync (native Android client, if used) ---
SYNC_API_URL=https://dietbuddy.buildc3.tech